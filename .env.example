# ---- Server ----
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bhorsha
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins (the client address)
CORS_ORIGIN=http://localhost:5173
# Cookie settings. For a cross-site deployment use COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Shared secret for the bKash / bank payment webhook (HMAC-SHA256). Empty = derived from JWT_SECRET.
PAYMENT_WEBHOOK_SECRET=
# Platform administrator (sees every lender and investor at /admin). Without both, there is no admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- AI (optional). Leave the key empty to run with the labelled DEMO FALLBACK ----
# AI_PROVIDER: anthropic | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=45000

# Path to the exported model (written by `npm run train`). Missing file = rules-only verdicts.
MODEL_PATH=ml/model/model.json
EVAL_PATH=ml/model/eval.json

# ---- Client (Vite). Leave empty locally: Vite proxies /api to the server ----
VITE_API_URL=
